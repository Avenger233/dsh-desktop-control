{
  "name": "@avengers233/dsh-desktop-control",
  "version": "1.3.0",
  "description": "Windows desktop mouse, keyboard, OCR text search, UI Automation (list/activate/elements/invoke) and screenshot control for DeepSeek Harness sessions: desktop_mouse, desktop_keyboard, desktop_state, desktop_screenshot, desktop_find, desktop_window, desktop_sequence.",
  "type": "module",
  "license": "MIT",
  "author": "Avenger233",
  "homepage": "https://github.com/Avenger233/dsh-desktop-control#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Avenger233/dsh-desktop-control.git"
  },
  "bugs": {
    "url": "https://github.com/Avenger233/dsh-desktop-control/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "desktop",
    "mouse",
    "keyboard",
    "screenshot",
    "automation",
    "windows",
    "computer-use",
    "ocr",
    "uia",
    "ui-automation"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "selftest": "node scripts/selftest.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "helper.ps1",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "scripts/selftest.mjs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
